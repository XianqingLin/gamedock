// GameDock 平台部署配置(Cloudflare Workers)。
// database_id / KV id 在首次 `wrangler d1 create` / `wrangler kv namespace create` 后回填。
// 会话密钥不入库:`wrangler secret put GAMEDOCK_SESSION_SECRET`;本地开发见 .dev.vars。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamedock",
  "main": "server/worker.mjs",
  "compatibility_date": "2025-09-01",
  "routes": [
    { "pattern": "gamedock.cn", "custom_domain": true },
    { "pattern": "www.gamedock.cn", "custom_domain": true },
    // 游戏内容域:游戏静态资源(R2),与平台跨源隔离;部署时自动创建 DNS 记录。
    { "pattern": "games.gamedock.cn", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/g/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamedock",
      "database_id": "66fd8797-cc1d-4879-aea7-d0394695d113"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SAVES",
      "id": "78c8a7b855aa47a79b2da334ac40ec1d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GAMES",
      "bucket_name": "gamedock-games"
    }
  ],
  // AI 助手(小舟AI)通用 API:OpenAI 兼容的 chat/completions 端点与模型名;
  // 密钥不入库:wrangler secret put AI_API_KEY。两者未配置时聊天返回明确报错。
  "vars": {
    "AI_API_BASE_URL": "",
    "AI_API_MODEL": ""
  },
  "observability": {
    "enabled": true
  }
}
