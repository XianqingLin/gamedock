// GameDock 平台部署配置(Cloudflare Workers)。
// database_id / KV id 在首次 `wrangler d1 create` / `wrangler kv namespace create` 后回填。
// 会话密钥不入库:`wrangler secret put GAMEDOCK_SESSION_SECRET`;本地开发见 .dev.vars。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamedock",
  "main": "server/worker.mjs",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamedock",
      "database_id": "TODO_D1_DATABASE_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SAVES",
      "id": "TODO_KV_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
