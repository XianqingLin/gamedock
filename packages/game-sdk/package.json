{
  "name": "@xlp/game-sdk",
  "version": "0.1.0",
  "description": "小林游戏铺游戏侧 SDK:平台握手 + 存档 API 封装。平台内嵌游戏统一从此接入,不直接拼平台内部 URL。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
